#! /bin/bash
# Start CATS Digicon — same style as /home/pi/JMRI/PanelPro desktop launcher.
set -euo pipefail
cd /home/pi/JMRI

export WIRINGPI_GPIOMEM="${WIRINGPI_GPIOMEM:-1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

# labwc/Xwayland on this Pi uses :1 (not :0). Prefer an existing session value.
if [[ -z "${DISPLAY:-}" ]]; then
  for d in :1 :0; do
    if xdpyinfo -display "$d" >/dev/null 2>&1; then
      export DISPLAY="$d"
      break
    fi
  done
  export DISPLAY="${DISPLAY:-:1}"
fi

PANEL="${1:-/home/pi/hart/cats/panels/sheets/HART_Master.xml}"
PROFILE="${JMRI_PROFILE:-TCS_MQTT.3f32a166}"

exec ./cats.csh --profile="$PROFILE" "$PANEL"
