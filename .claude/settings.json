{
  "enabledPlugins": {
    "model-railroad-skills@model-railroad-skills": true
  },
  "extraKnownMarketplaces": {
    "model-railroad-skills": {
      "source": {
        "source": "github",
        "repo": "lnevo/model-railroad-skills"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/main_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check_after_edit.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git submodule status)",
      "Bash(git submodule status *)",
      "Bash(git check-ignore *)",
      "Bash(sips -g *)",
      "Bash(javap *)",
      "Bash(gh run watch *)",
      "Bash(shellcheck *)",
      "Bash(shasum *)",
      "mcp__plugin_sts_sts-api__sts_list",
      "mcp__plugin_sts_sts-api__sts_health",
      "mcp__plugin_sts_sts-api__sts_session",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages"
    ]
  }
}
