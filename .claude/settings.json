{
  "enabledPlugins": {
    "model-railroad-skills@model-railroad-skills": true
  },
  "extraKnownMarketplaces": {
    "model-railroad-skills": {
      "source": {
        "source": "github",
        "repo": "lnevo/model-railroad-skills"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/main_guard.py\""
          }
        ]
      }
    ]
  }
}
