{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(git submodule status)",
      "Bash(git submodule status *)",
      "Bash(git check-ignore *)",
      "Bash(sips -g *)",
      "Bash(javap *)",
      "Bash(gh run watch *)",
      "Bash(shellcheck *)",
      "Bash(shasum *)",
      "mcp__plugin_sts_sts-api__sts_list",
      "mcp__plugin_sts_sts-api__sts_health",
      "mcp__plugin_sts_sts-api__sts_session",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "Bash(python3 tools/audit/check_ai_speak.py)",
      "Bash(python3 tools/audit/check_ai_speak.py *)",
      "Bash(tools/hosts/operating.sh status)",
      "Bash(make deploy-status)",
      "Bash(make deploy-status *)",
      "Bash(python3 tools/schematic/check_approved.py)",
      "Bash(python3 tools/schematic/check_approved.py --check)",
      "Bash(python3 tools/ops/pipeline_query.py *)",
      "Bash(make orient)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/main_guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/edit_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check_after_edit.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree_sweep.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree_sweep.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "model-railroad-skills@model-railroad-skills": true,
    "car-cards@model-railroad-skills": false,
    "operations-pro@model-railroad-skills": false
  },
  "extraKnownMarketplaces": {
    "model-railroad-skills": {
      "source": {
        "source": "github",
        "repo": "lnevo/model-railroad-skills"
      }
    }
  }
}
