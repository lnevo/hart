# Consolidation workspace — local environment
# Copy to consolidation.env and edit paths when moving machines:
#   cp consolidation/env/consolidation.env.example consolidation/env/consolidation.env
#
# Then: source consolidation/env/load_consolidation_env.sh
# All consolidation scripts source this automatically.

# Optional — GPT curation (OPENAI_API_KEY in .env.local or consolidation.env)
# OPENAI_API_KEY=sk-...
CONSOLIDATION_ROOT=/Users/lnevo/hart/consolidation

# --- Consolidation runtime (defaults derived from CONSOLIDATION_ROOT if unset) ---
# HART_REPO_ROOT=/Users/lnevo/hart
# HART_RUNTIME_ROOT=$HART_REPO_ROOT
# HART_LIVE_ROOT=$HART_RUNTIME_ROOT
# DESKTOP_DATA_ROOT=$CONSOLIDATION_ROOT/external/desktop-data
# HART_OPS_ROOT=$CONSOLIDATION_ROOT/external/hart-ops
# LCOS_BRIDGE_ROOT=$CONSOLIDATION_ROOT/external/lcos-bridge
# STS_DOCKER_ROOT=$CONSOLIDATION_ROOT/external/sts-docker
# STS_HELPERS_ROOT=$CONSOLIDATION_ROOT/external/sts-helpers
# STS_DATA_ROOT=$CONSOLIDATION_ROOT/external/sts-docker-data

# STS runtime data (consolidation mirror — used by Docker + helpers)
# STS_BACKUPS_DIR=$STS_DATA_ROOT/backups
# STS_DATABASE_DIR=$STS_DATA_ROOT/database
# STS_IMAGES_DIR="$STS_DATA_ROOT/Rolling Stock photos"
# STS_DOCKER=$STS_DOCKER_ROOT
# After editing CONSOLIDATION_ROOT, run:
#   bash consolidation/scripts/refresh_sts_docker_compose.sh

# Car cards workspace
# HART_CAR_CARDS_ROOT=$DESKTOP_DATA_ROOT/car-cards
# HART_CAR_IMAGES_FINAL=$DESKTOP_DATA_ROOT/car-images/CarImagesFinal
# HART_STS_HELPERS=$STS_HELPERS_ROOT

# --- Mirror sources (live read-only — rsync FROM these INTO consolidation) ---
# HART_MIRROR_SRC=/Users/lnevo/hart
# DESKTOP_HART=$HOME/Desktop/HART
# MIRROR_STS_BACKUPS=$HOME/sts/sts-backups
# MIRROR_STS_DATABASE=$HOME/sts/sts-database
# MIRROR_STS_IMAGES=$HOME/sts/sts-images
# DESKTOP_MIRROR_RAW=1   # include Car Cards/Images (~1 GB)

# --- Infrastructure (hosts / lab) ---
HART_MQTT_BROKER=minipc-e5h6x.local
HART_MQTT_PORT=1883
HART_LCOS_COM=COM3

export JMRI_LAYOUT=hart
