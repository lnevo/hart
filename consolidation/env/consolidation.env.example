# Consolidation workspace — local environment (copy to consolidation.env and source)

# Layout ops mirror (default: external/hart-runtime when present)
# HART_LIVE_ROOT=/path/to/hart/consolidation/external/hart-runtime

# Car card final photos (default: external/desktop-data/car-images/CarImagesFinal)
# HART_CAR_IMAGES_FINAL=/path/to/hart/consolidation/external/desktop-data/car-images/CarImagesFinal

# STS helpers (default: external/sts-helpers sibling of hart-ops)
# HART_STS_HELPERS=/path/to/hart/consolidation/external/sts-helpers

# Mirror sources (read-only rsync from live)
# HART_MIRROR_SRC=/path/to/hart
# DESKTOP_HART=$HOME/Desktop/HART
# STS_BACKUPS=$HOME/sts/sts-backups
# DESKTOP_MIRROR_RAW=1   # include Car Cards/Images (~1 GB)

# MQTT broker (prerequisite — packages/infra/mqtt-broker/)
HART_MQTT_BROKER=minipc-e5h6x.local
HART_MQTT_PORT=1883

# LCOS Windows COM
HART_LCOS_COM=COM3

# Car cards workspace (after setup_car_cards_workspace.sh)
# HART_CAR_CARDS_ROOT=.../consolidation/external/desktop-data/car-cards
# HART_CAR_IMAGES_FINAL=.../consolidation/external/desktop-data/car-images/CarImagesFinal

export JMRI_LAYOUT=hart
