# HART local environment
# Copy to hart.env and edit paths when moving machines:
#   cp tools/env/hart.env.example tools/env/hart.env
#
# Then: source tools/env/load_env.sh
# Scripts in tools/ops source this automatically.

# Optional — GPT curation (OPENAI_API_KEY in .env.local or hart.env)
# OPENAI_API_KEY=sk-...

# --- Paths (defaults derived from the repo root if unset) ---
# HART_REPO_ROOT=/Users/lnevo/hart
# HART_RUNTIME_ROOT=$HART_REPO_ROOT
# HART_LIVE_ROOT=$HART_RUNTIME_ROOT
# HART_OPS_ROOT=$HART_REPO_ROOT/external/hart-ops
# LCOS_BRIDGE_ROOT=$HART_REPO_ROOT/external/lcos-bridge
# STS_DOCKER_ROOT=$HART_REPO_ROOT/external/sts-docker
# STS_HELPERS_ROOT=$HART_REPO_ROOT/external/sts-helpers
# STS_DATA_ROOT=$HART_REPO_ROOT/external/sts-docker-data

# STS runtime data (used by Docker + helpers)
# STS_BACKUPS_DIR=$STS_DATA_ROOT/backups
# STS_DATABASE_DIR=$STS_DATA_ROOT/database
# STS_IMAGES_DIR="$STS_DATA_ROOT/Rolling Stock photos"
# STS_DOCKER=$STS_DOCKER_ROOT
# After changing STS paths, run:
#   bash tools/ops/refresh_sts_docker_compose.sh

# Car cards workspace
# HART_CAR_CARDS_ROOT=$HART_REPO_ROOT/ops/car-cards
# HART_CAR_IMAGES_FINAL=$HART_CAR_CARDS_ROOT/car-images/CarImagesFinal
# HART_STS_HELPERS=$STS_HELPERS_ROOT

# --- Infrastructure (hosts / lab) ---
HART_MQTT_BROKER=minipc-e5h6x.local
HART_MQTT_PORT=1883
HART_LCOS_COM=COM3

export JMRI_LAYOUT=hart
