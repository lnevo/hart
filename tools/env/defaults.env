# Default host settings, the one copy. Read by tools/env/load_env.sh (shell) and
# tools/hartlib/src/hartlib/hosts.py (Python); each name is used only when neither the
# environment nor tools/env/hart.env sets it. Plain KEY=VALUE lines, no quotes or $VAR.
#
# Files that run on a host without this repo keep their own copy, and
# tools/hosts/tests/test_host_copies.py fails when one of them disagrees with this file.

# The Pi (RPi-JMRI.local) runs Mosquitto, JMRI and the live STS. On the Pi itself the broker is 127.0.0.1.
HART_MQTT_BROKER=10.0.0.150
HART_MQTT_PORT=1883
HART_JMRI_JSON=http://10.0.0.150:12080/json
# ssh to the Pi: a host or ~/.ssh/config alias.
HART_PI_SSH=pi
HART_PI_USERFILES=/home/pi/JMRI_UserFiles
# The Pi's name in web links (the Mac JMRI web home's speed-match link), not an ssh target.
HART_PI_WEB_HOST=RPi-JMRI.local
# ssh to Windows (OpenSSH on port 2222). The Windows box is never the broker.
HART_WIN_SSH=lnevo@minipc-e5h6x.local
HART_WIN_SSH_PORT=2222
HART_WIN_USERFILES=C:/Users/lnevo/JMRI_UserFiles
