# sdm pluglist for the layout Pi (docs/hosts/PI_OS_REBUILD.md).
# inside_vm.sh fills @STAGE@ (the staged copy of this folder, the secrets and the
# checkouts), then runs sdm --customize with it.
# Syntax: https://github.com/gitbls/sdm/blob/master/Docs/Plugins.md

# The trixie image already has a locked placeholder pi (uid 1000, nologin), so sdm's
# adduser only marks pi as its main user (desktop autologin); the account itself is
# fixed in post-install below. docker and lpadmin are added at first boot.
user:adduser=pi|uid=1000
L10n:keymap=us|locale=en_US.UTF-8|timezone=America/New_York|wificountry=US
# cloud-init and netplan would move the NetworkManager profiles to /run (sdm Hints-Trixie).
disables:cloudinit|piwiz|triggerhappy
network:netman=nm|nmconn=@STAGE@/net/Easte.nmconnection,@STAGE@/net/RPi-JMRI.nmconnection,@STAGE@/os/network/Ethernet.nmconnection
network:cname=lo|ifname=lo|ctype=loopback|ipv4-static-ip=127.0.0.1/8|autoconnect=no

apps:name=hart|apps=@@STAGE@/os/apps.txt
docker-install
samba:shares=@STAGE@/os/samba-shares.conf
vnc:wayvnc
# Printing stays (owner, 2026-11-23); the two HP printers are added again from the CUPS page.

sshhostkey:import-keys=@STAGE@/private/ssh-host-keys
copyfile:from=@STAGE@/private/authorized_keys|to=/home/pi/.ssh|chown=pi:pi|chmod=600|mkdirif
# sdm spells the phase two ways: copyfile takes postinstall, runcommand post-install.
copyfile:from=@STAGE@/private/passdb.tdb|to=/var/lib/samba/private|chown=root:root|chmod=600|mkdirif|runphase=postinstall

# Card-only system files and the pi user's desktop settings, kept in rootfs/.
# -K keeps the image's merged-/usr links (/lib -> usr/lib) instead of replacing them.
copydir:from=@STAGE@/os/rootfs/system/|to=/|rsyncopts=-rlptK --chown=root:root
copydir:from=@STAGE@/os/rootfs/home-pi/|to=/home/pi/|rsyncopts=-rlptK --chown=1000:1000
# JMRI 5.16 as it runs on the old card (CATS installed into it), STS and the bridge checkouts.
copydir:from=@STAGE@/home/|to=/home/pi/|rsyncopts=-rlptK --chown=1000:1000
runcommand:command=ln -sfn JMRI.5.16 /home/pi/JMRI && chown -h 1000:1000 /home/pi/JMRI|runphase=post-install
# pi gets a login shell and the old card's password hash, from a root-only file; then that
# file and copyfile's staged copy are removed, and home and .ssh get the modes ssh insists on.
# pi gets passwordless sudo as on the old card (deploys and pi_quit_panelpro.sh use sudo -n);
# sudo wants that file at 0440, which git cannot store.
# The grep refuses anything that is not a crypt hash, so pi can never end up passwordless.
copyfile:from=@STAGE@/private/pi.hash|to=/etc/sdm/assets/hart|chown=root:root|chmod=600|mkdirif
runcommand:command=grep -q '^[$]' /etc/sdm/assets/hart/pi.hash && usermod -s /bin/bash -p "$(cat /etc/sdm/assets/hart/pi.hash)" pi && rm -f /etc/sdm/assets/hart/pi.hash /etc/sdm/assets/copyfile/*/pi.hash && chown -R 1000:1000 /home/pi/.ssh && chmod 700 /home/pi /home/pi/.ssh && chmod 440 /etc/sudoers.d/010_pi-nopasswd|runphase=post-install

system:name=hart|service-enable=wifi-watchdog,mosquitto,smbd,nmbd,cups|service-disable=lcos-bridge|service-mask=samba-ad-dc
# Display fix 1: the stored EDID for each port; the video= entries and the initramfs come from
# display-setup.sh (sdm's cmdline add keeps only one entry per name, and we need two video=).
cmdline:add=cfg80211.ieee80211_regdom=US drm.edid_firmware=HDMI-A-1:edid/edid.bin,HDMI-A-2:edid/edid2.bin
runcommand:command=/usr/local/lib/hart/display-setup.sh && rm -f /usr/local/lib/hart/display-setup.sh|runphase=post-install
runatboot:script=@STAGE@/os/firstboot.sh|output=/var/log/hart-firstboot.log
