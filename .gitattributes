# STATUS entries are independent lines that many branches add at once: keep both sides instead of a conflict
# (git's built-in union merge; tools/ops/status_counts.py --check stops on a duplicated entry it can leave).
wiki/STATUS.md merge=union
wiki/STATUS_LOG.md merge=union
# docs/INDEX.md lists one row per document, and parallel branches add rows near each other; keep both sides
# (owner, 2026-11-25, ADR-036). build_docs_index.py --check fails on a row left twice or a list that differs.
docs/INDEX.md merge=union
# The pipeline map's graph merges itself by node id and edge ends: tools/ops/merge_pipeline_map.py, set up by make wt
# and the session-start hook (--install). GitHub never runs this driver: merge origin/main into the branch locally.
# The two map pages built from it are not committed (ADR-036).
docs/pipeline-map/pipeline_map.json merge=pipeline-map
