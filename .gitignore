# Do not commit the nested git checkout.
tools/cats/src-repo/

# Accidental `jar xf cats.jar` into this repo (runtime .class). Never commit.
# Read Java from tools/cats/src-repo — do not explode the jar into cats/.
META-INF/
cats/**/*.class
cats/panels/_qa_*.png
cats/panels/*.png
cats/panels/sheets/*.pre_*

